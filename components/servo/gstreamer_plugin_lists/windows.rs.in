// The format of this file is intended to be directly `include!()` able as a [&'static str] in Rust,
// and a valid python list[str] after stripping the `//` comments at the beginning of lines (from gstreamer.py).
[
// gst-plugins-bad
"gstd3d11",
// Video capture device providers + sources for getUserMedia (capture cards / webcams).
// gstwinks (ksvideosrc) is used despite not being GStreamer's recommended source,
// due to the wall's capture hardware constraints. mediafoundation/directshow are
// registered as alternatives. All depend only on base libs already in
// GSTREAMER_BASE_LIBS (gstd3d11/gstvideo/gstaudio/gstpbutils/gstbase/gstreamer).
"gstdirectshow",
"gstmediafoundation",
"gstwasapi",
"gstwinks"
]