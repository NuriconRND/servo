# WebRender 0.68.0 — env-gated picture-caching disable (EXPERIMENTAL / UNVERIFIED)
#
# Env var: WR_DISABLE_PICTURE_CACHING=1
# Applies to the `webrender` 0.68.0 crate (src/tile_cache.rs + src/picture.rs).
# Requires the local fork wired via servo/Cargo.toml:
#     [patch.crates-io]
#     webrender = { path = "../webrender/webrender" }
#
# STATUS: this is the "attempt 3" variant — keep the TileCache root (so scene/
# frame builder do not panic) but, when the env is set, SKIP the per-frame
# dependency comparison in Tile::update_content_validity and just invalidate the
# whole tile. On a single-monitor dev test this showed RUNAWAY update_ms growth
# (bookkeeping side effects), i.e. it did NOT achieve the recovery. Two earlier
# variants both PANIC and are dead ends (do not use):
#   - root composite None  -> scene_building.rs "bug: no parent"
#   - root composite Blit  -> frame_builder.rs "bug: not a tile cache"
# Kept here for the record / for further experimentation on real hardware.
#
# Apply from the webrender crate root:  git apply <this-file>   (or patch -p1)
# Env OFF (default) = pristine behavior; only WR_DISABLE_PICTURE_CACHING=1 activates it.

--- a/src/tile_cache.rs
+++ b/src/tile_cache.rs
@@ -16,6 +16,14 @@ use crate::spatial_tree::{SpatialNodeIndex, SceneSpatialTree};
 use crate::util::VecHelper;
 use std::mem;

+/// Multi-GPU video-wall workaround: disable WebRender picture caching when
+/// `WR_DISABLE_PICTURE_CACHING` is set in the environment. Read once (scene
+/// build time), so toggling requires a restart.
+pub(crate) fn picture_caching_disabled() -> bool {
+    static DISABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *DISABLED.get_or_init(|| std::env::var("WR_DISABLE_PICTURE_CACHING").is_ok())
+}
+
 /*
  Types and functionality related to picture caching. In future, we'll
  move more and more of the existing functionality out of picture.rs
--- a/src/picture.rs
+++ b/src/picture.rs
@@ -903,6 +903,18 @@ impl Tile {
         state: &mut TileUpdateDirtyState,
         frame_context: &FrameVisibilityContext,
     ) {
+        // Multi-GPU video-wall workaround: when picture caching is disabled, skip the
+        // O(primitives x quadtree) dependency comparison and just invalidate the whole
+        // tile (re-rasterize every frame). For all-dynamic content everything is dirty
+        // anyway, so the comparison is pure overhead - and it is the dominant cost of
+        // renderer.update() at large surface sizes. The tile-cache structure stays
+        // intact, so there is no scene/frame-builder panic.
+        if crate::tile_cache::picture_caching_disabled() {
+            self.invalidate(None, InvalidationReason::ScaleChanged);
+            state.composite_state.dirty_rects_are_valid = false;
+            return;
+        }
+
         // Check if the contents of the primitives, clips, and
         // other dependencies are the same.
         state.compare_cache.clear();
