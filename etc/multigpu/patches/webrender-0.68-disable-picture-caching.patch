# webrender-0.68-disable-picture-caching.patch
#
# What it does:
#   Adds an environment-gated bypass for WebRender picture caching.
#   When WR_DISABLE_PICTURE_CACHING is set (any value), every call to
#   create_tile_cache() emits a normal None-composite PicturePrimitive
#   instead of a TileCache-composite one, so WebRender skips per-frame
#   tile dirty/dependency tracking for all-dynamic content (e.g., video
#   wall tiles where every primitive changes every frame).
#
# Applies to:
#   webrender 0.68.0  —  src/tile_cache.rs
#   (Servo fork, function create_tile_cache, ~line 640)
#
# Prerequisites:
#   1. A local fork checkout at (e.g.):
#        F:\...\webrender\webrender
#   2. The [patch.crates-io] slot active in servo/Cargo.toml:
#        [patch.crates-io]
#        webrender = { path = "../webrender/webrender" }
#   3. Apply with:
#        patch -p1 < webrender-0.68-disable-picture-caching.patch
#      from inside the fork root (F:\...\webrender\webrender), or apply
#      the two hunks manually to src/tile_cache.rs.
#
# Usage:
#   Set WR_DISABLE_PICTURE_CACHING=1 (or any value) before launching
#   servoshell / winit_wall. Unset to restore normal tile-cache behaviour.
#   Toggling requires a process restart (value is read once at scene-build
#   time via OnceLock).
#
diff --git "a/C:\\Users\\nuricon\\.cargo\\registry\\src\\index.crates.io-1949cf8c6b5b557f\\webrender-0.68.0\\src\\tile_cache.rs" "b/F:\\20260609_SDWall_BrowserTest\\20260606_multigpu_browser\\webrender\\webrender\\src\\tile_cache.rs"
index c1cecc561cb..3a85d78743e 100644
--- "a/C:\\Users\\nuricon\\.cargo\\registry\\src\\index.crates.io-1949cf8c6b5b557f\\webrender-0.68.0\\src\\tile_cache.rs"
+++ "b/F:\\20260609_SDWall_BrowserTest\\20260606_multigpu_browser\\webrender\\webrender\\src\\tile_cache.rs"
@@ -16,6 +16,14 @@ use crate::spatial_tree::{SpatialNodeIndex, SceneSpatialTree};
 use crate::util::VecHelper;
 use std::mem;
 
+/// Multi-GPU video-wall workaround: disable WebRender picture caching when
+/// `WR_DISABLE_PICTURE_CACHING` is set in the environment. Read once (scene
+/// build time), so toggling requires a restart.
+fn picture_caching_disabled() -> bool {
+    static DISABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *DISABLED.get_or_init(|| std::env::var("WR_DISABLE_PICTURE_CACHING").is_ok())
+}
